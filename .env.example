# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SUPABASE-SERVICE-ROLE-KEY

# Bunny Stream (Dashboard → Stream → API / Security)
BUNNY_LIBRARY_ID=YOUR-BUNNY-LIBRARY-ID
BUNNY_STREAM_KEY=YOUR-BUNNY-STREAM-API-KEY
BUNNY_TOKEN_AUTH_KEY=YOUR-BUNNY-TOKEN-AUTH-KEY

# Stripe (use test credentials while validating, then replace with live credentials)
STRIPE_SECRET_KEY=YOUR-STRIPE-SECRET-KEY
STRIPE_WEBHOOK_SECRET=YOUR-STRIPE-WEBHOOK-SECRET

# Optional locally; set the operator-owned canonical HTTPS origin before a production build
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CURRENCY=USD

# Private lessons (international phone number, digits only, including country code; no + or spaces)
NEXT_PUBLIC_TRAINER_WHATSAPP_NUMBER=
